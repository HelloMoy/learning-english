# OpenUI — required environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─────────────────────────────────────────────
# MiniMax API (MiniMax) — REQUIRED
# ─────────────────────────────────────────────
# Get your API key at: https://platform.MiniMax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=sk-cp-your-key-here

# Optional: model to use (defaults to MiniMax-M3)
# Available models: MiniMax-M3, MiniMax-Text-01, etc.
MINIMAX_MODEL=MiniMax-M3

USE_COURSE_CONTENT_SEED=1

# ─────────────────────────────────────────────
# Course content storage — OPTIONAL
# ─────────────────────────────────────────────
# Where course media (videos, posters, resource files) is served from.
# The generated seed stores opaque content KEYS; these two vars decide how a
# key becomes a URL and where its bytes are read from, so repointing storage
# (local folder → S3/R2 bucket) needs no seed regeneration.
#
# Public URL prefix. Defaults to the local folder Next.js serves from /public.
# CONTENT_BASE_URL=/local-filesystem-lesson
#
# Filesystem root the local driver reads bytes from (used by the notes reader
# and by existence checks). Relative paths resolve against the process CWD.
# CONTENT_LOCAL_ROOT=public/local-filesystem-lesson
