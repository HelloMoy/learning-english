---
/**
 * The portal's brand: the `ENGLISH·COURSE` wordmark tagged `DOCS`, in the same
 * shape the API reference (`API`) and Storybook (`DESIGN SYSTEM`) wear.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label="English Course docs, home" translate="no">
  <span class="wordmark">ENGLISH<span class="wordmark-dot">·</span>COURSE</span>
  <span class="docs-tag">DOCS</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .wordmark {
    font-weight: 800;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0.26em;
    white-space: nowrap;
  }

  .wordmark-dot {
    padding-inline: 0.15em;
    color: var(--sl-color-accent);
  }

  .docs-tag {
    padding: 4px 8px 4px 10px;
    border: 1px solid color-mix(in oklab, var(--sl-color-accent) 40%, transparent);
    border-radius: 6px;
    background: color-mix(in oklab, var(--sl-color-accent) 10%, transparent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: var(--sl-color-accent);
  }
</style>
