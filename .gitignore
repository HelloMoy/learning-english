# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug-storybook.log

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is the one file a new
# clone needs in order to know which variables exist. The negation must stay
# narrow: `.env` itself holds real API keys and must never be tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skills.sh — installed skills are managed by `npx skills install`, not git
# Local skills live in `.agents/local-skills/` and ARE tracked.
.agents/skills/

# typedoc — generated by `pnpm docs`. Regenerate locally or in CI; never commit.
/docs/

# courses — the multi-GB content root, ignored wholesale by default.
#
# The trailing `/*` (not a bare `/`) matters: git does not descend into an
# excluded directory, so a bare rule would make the negations below unreachable.
public/local-filesystem-lesson/*

# ...except the Basic Course's text assets. Its 48 lectures are served by
# YouTube (declared in `src/content/basic-course.json`), so what remains on
# disk is ~25 MB of notes, posters and PDFs — small enough to track, and the
# one part of the content tree a fresh clone cannot regenerate.
!public/local-filesystem-lesson/basic-course/

# Video bytes are never tracked, whichever course they belong to. This rule is
# what keeps the negation above safe while the Basic Course's .mp4 files are
# still on disk, and it keeps a future course from silently pushing gigabytes.
public/local-filesystem-lesson/**/*.mp4
public/local-filesystem-lesson/**/*.mov
public/local-filesystem-lesson/**/*.webm
public/local-filesystem-lesson/**/*.mkv